# Copy this file to .env and fill in your values (restart `npm run dev` after editing)

# ---------- Cloudinary (replace with your own) ----------
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=products

# ---------- Firebase Admin (server side) ----------
# Firebase console -> Project settings -> Service accounts -> Generate new private key
# Save the JSON next to package.json as serviceAccountKey.json
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
# (alternative for hosting: paste the whole JSON on one line)
# FIREBASE_SERVICE_ACCOUNT_JSON=

# ---------- Firebase Web config (login in the browser) ----------
# Firebase console -> Project settings -> General -> Your apps -> Web app
FIREBASE_WEB_API_KEY=your_web_api_key
FIREBASE_WEB_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_WEB_PROJECT_ID=your-project-id
FIREBASE_WEB_APP_ID=your_app_id

# ---------- Temporary bypass login button ----------
# true  = shows a "Bypass" button beside Login (for development)
# false = hides it and the server rejects bypass tokens. SET FALSE BEFORE GOING LIVE.
BYPASS_ENABLED=true
# Optional: secret used to sign bypass tokens (any long random text).
# Needed if you deploy to a host that runs several server copies.
BYPASS_SECRET=
